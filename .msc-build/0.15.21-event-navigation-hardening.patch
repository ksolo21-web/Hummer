+private fun CompanionHubRepository.setActiveWorkbookSafely(bookId: String, pageKey: String) {
+    if (bookId.isBlank() || pageKey.isBlank()) return
+    try {
+        setActiveWorkbook(bookId, pageKey)
+    } catch (_: Exception) {
+        // Opening the workbook must remain usable even when local state persistence fails.
+    }
+}
