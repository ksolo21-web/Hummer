ied JW.org or Watchtower Online Library material in the current source library to answer that safely. Refresh official sources or switch to Smart Online AI."
+            } else {
+                "I do not have enough verified material stored offline to answer that safely. Reconnect, refresh official sources, or use Smart Online AI when available."
+            }
+            return AnswerResult(
+                answer = safeMessage,
+                citations = emptyList(),
+                providerLabel = "Private source guidance",
+            )
+        }
+        val prompt = AiPromptBuilder.build(question, passages)
+        val initial = providerRouter.generate(prompt)
+        val validatedInitial = runCatching {
+            AiGroundingValidator.validateAndResolve(initial.first, passages)
+        }
+        val (grounded, provider) = if (validatedInitial.isSuccess) {
+            validatedInitial.getOrThrow() to initial.second
+        } else {
+            val guided = providerRouter.generateGuided(prompt)
+            AiGroundingValidator.validateAndResolve(guided.first, passages) to guided.second
+        }
+        val usedCitations = grounded.usedPassageIndexes
+            .map(passages::get)
+            .map { it.citation() }
+            .distinctBy { it.url }
+            .take(5)
+        return AnswerResult(
+            answer = grounded.body,
+            citations = usedCitations,
+            providerLabel = provider.label,
+        )
+    }
+
+    private suspend fun saveAssistantMessage(answer: String, citations: List<StudyCitation>) {
+        dao.upsertAiMessage(
+            AiStudyMessage(
+                id = UUID.randomUUID().toString(),
+                role = AiMessageRole.ASSISTANT,
+                body = answer,
+                citations = citations,
+                createdAtEpochMillis = System.currentTimeMillis(),
+            ).toEntity(),
+        )
     }
 
     private fun setError(message: String) {
         mutableRequestState.value = mutableRequestState.value.copy(error = message)
     }
+
+    private data class AnswerResult(
+        val answer: String,
+        val citations: List<StudyCitation>,
+        val providerLabel: String,
+        val followUps: List<String> = emptyList(),
+        val usedFallback: Boolean = false,
+    )
+
+    private class SmartOnlineUnavailableException(
+        message: String,
+        cause: Throwable? = null,
+    ) : IllegalStateException(message, cause)
+
+    private fun Throwable.safeUserDetail(): String = when {
+        message?.contains("403") == true -> "The app has not finished registering with the private service. Try again after a moment."
+        message?.contains("429") == true -> "The hourly assistant limit was reached. Try again later."
+        message?.contains("status 5") == true -> "The private AI service reported a temporary error."
+        else -> "Check the connection and private-service configuration."
+    }
+
+    companion object {
+        private const val PREFERENCES_NAME = "ai_assistant_preferences"
+        private const val KEY_MODE = "assistant_mode"
+        private const val KEY_CLOUD_SESSION_ID = "cloud_session_id"
+    }
 }
