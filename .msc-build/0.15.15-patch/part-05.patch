+def _answer_is_substantive(question: str, answer: str) -> bool:
+    clean = " ".join(answer.split())
+    if len(clean) < 80 or len(clean) > 12000:
+        return False
+    lowered = clean.lower()
+    generic_failures = (
+        "i cannot answer that",
+        "please provide more context",
+        "i don't have enough information",
+    )
+    if any(item in lowered for item in generic_failures) and len(clean) < 220:
+        return False
+    meaningful_terms = {
+        token.lower()
+        for token in re.findall(r"[A-Za-z]{4,}", question)
+        if token.lower() not in {"what", "when", "where", "which", "would", "could", "please", "about", "explain"}
+    }
+    return not meaningful_terms or any(term in lowered for term in meaningful_terms)
+
