+    def line_detail(self, points, width=4):
+        self.ld.line(points, fill=OUTLINE, width=width, joint="curve")
+        self.md.line(points, fill=OUTLINE, width=width, joint="curve")
+
+    def detail_ellipse(self, box, fill=OUTLINE, width=3):
+        self.ld.ellipse(box, fill=fill, outline=OUTLINE, width=width)
+        self.md.ellipse(box, fill=fill, outline=OUTLINE, width=width)
