+    def finish(self, out_dir: Path, asset: dict):
+        out_dir.mkdir(parents=True, exist_ok=True)
+        self.master.convert("RGB").save(out_dir / "color-master.webp", "WEBP", quality=94, method=6)
+        self.line.convert("RGB").save(out_dir / "color-line.png", "PNG", optimize=True)
+        self.mask.save(out_dir / "color-region-mask.png", "PNG", optimize=True)
+        mask_pixels = list(self.mask.get_flattened_data())
+        region_payload = []
+        for region in self.regions:
+            pixel_count = sum(1 for p in mask_pixels if p[0] == region.id)
+            cx, cy = region.center
+            px = min(W - 1, max(0, cx))
+            py = min(H - 1, max(0, cy))
+            actual = self.mask.getpixel((px, py))[0]
+            if actual != region.id:
+                # Find a stable interior point nearest to the requested center.
+                candidates = [(abs((i % W) - cx) + abs((i // W) - cy), i) for i, p in enumerate(mask_pixels) if p[0] == region.id]
+                if not candidates:
+                    raise RuntimeError(f"Region {region.id} in {asset['id']} is empty")
+                _, index = min(candidates)
+                px, py = index % W, index // W
+            if pixel_count < 900:
+                raise RuntimeError(f"Region {region.id} in {asset['id']} is too small: {pixel_count}")
+            region_payload.append({
+                "id": str(region.id),
+                "number": region.number,
+                "label": region.label,
+                "centerX": round(px / (W - 1) * 1000),
+                "centerY": round(py / (H - 1) * 1000),
+                "pixelCount": pixel_count,
+            })
+        asset["colorRegions"] = region_payload
+        asset["colorRegionCount"] = len(region_payload)
+        asset["colorNumbersUsed"] = sorted({r.number for r in self.regions})
