+@dataclass
+class Region:
+    id: int
+    number: int
+    label: str
+    center: tuple[int, int]
+
+class Scene:
+    def __init__(self, title: str):
+        self.title = title
+        self.master = Image.new("RGBA", (W, H), WHITE)
+        self.line = Image.new("RGBA", (W, H), WHITE)
+        self.mask = Image.new("RGB", (W, H), (0, 0, 0))
+        self.md = ImageDraw.Draw(self.master)
+        self.ld = ImageDraw.Draw(self.line)
+        self.kd = ImageDraw.Draw(self.mask)
+        self.regions: list[Region] = []
+        self._next = 1
+
+    def _add(self, number: int, label: str, center: tuple[int, int], draw_fn: Callable[[ImageDraw.ImageDraw, object], None], args: object, width: int = 5):
+        rid = self._next
+        self._next += 1
+        color = PALETTE[number]
+        draw_fn(self.md, (args, color, OUTLINE, width))
+        draw_fn(self.ld, (args, WHITE, OUTLINE, width))
+        draw_fn(self.kd, (args, (rid, 0, 0), (rid, 0, 0), 0))
+        self.regions.append(Region(rid, number, label, center))
+
+    def polygon(self, points, number, label, center, width=5):
+        def fn(draw, data):
+            pts, fill, outline, w = data[0], data[1], data[2], data[3]
+            draw.polygon(pts, fill=fill)
+            if w: draw.line(list(pts) + [pts[0]], fill=outline, width=w, joint="curve")
+        self._add(number, label, center, fn, points, width)
+
+    def ellipse(self, box, number, label, center, width=5):
+        def fn(draw, data):
+            b, fill, outline, w = data[0], data[1], data[2], data[3]
+            draw.ellipse(b, fill=fill, outline=outline if w else None, width=w)
+        self._add(number, label, center, fn, box, width)
+
+    def rectangle(self, box, number, label, center, radius=0, width=5):
+        def fn(draw, data):
