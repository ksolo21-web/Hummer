ise-builders": ("Wise and Foolish Builders", scene_builders),
+    "armor-of-god": ("The Complete Suit of Armor", scene_armor),
+    "favorite-scripture": ("A Lamp to My Path", scene_scripture),
+    "favorite-animal": ("Jehovah's Animal Creation", scene_animal),
+    "faith-action": ("Faith in Action", scene_faith),
+    "gratitude-journal": ("A Grateful Family", scene_gratitude),
+}
+
+
+def main() -> None:
+    root = Path(__file__).resolve().parents[1]
+    workbook = root / "app/src/main/assets/workbook"
+    manifest_path = workbook / "manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    assets = {asset["id"]: asset for asset in manifest["assets"]}
+    for asset_id, (title, builder) in SCENES.items():
+        if asset_id not in assets:
+            raise RuntimeError(f"Missing workbook asset {asset_id}")
+        scene = Scene(title)
+        builder(scene)
+        scene.finish(workbook / asset_id, assets[asset_id])
+    manifest["version"] = 4
+    manifest["colorByNumberVersion"] = 2
+    manifest["palette"] = [
+        {"number": number, "label": PALETTE_LABELS[number], "rgb": "#%02X%02X%02X" % PALETTE[number][:3]}
+        for number in sorted(PALETTE)
+    ]
+    # Preserve original regions for backward compatibility, but use curated regions at runtime.
+    manifest["assets"] = [assets[asset["id"]] for asset in manifest["assets"]]
+    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    print(f"Generated {len(SCENES)} curated color-by-number scenes with meaningful closed regions.")
+
+if __name__ == "__main__":
+    main()
