+            .map { entity ->
+                val message = entity.toDomain()
+                AiStudyTurnDto(
+                    role = if (message.role == AiMessageRole.USER) "user" else "assistant",
+                    body = message.body.take(4_000),
+                )
+            }
+        val request = AiStudyRequestDto(
+            sessionId = preferences.getString(KEY_CLOUD_SESSION_ID, null),
+            question = question,
+            context = bundle.context,
+            recentMessages = recent,
+            localSources = bundle.passages.take(6).map { passage ->
+                AiStudySourceExcerptDto(
