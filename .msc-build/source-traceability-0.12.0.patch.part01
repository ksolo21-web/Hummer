+            .mapNotNull { it.groupValues.getOrNull(1)?.toIntOrNull() }
+            .toList()
+        val insufficient = clean.contains("not have enough", ignoreCase = true) ||
+            clean.contains("insufficient", ignoreCase = true) ||
+            clean.contains("could not find enough", ignoreCase = true)
+
         if (passages.isEmpty()) {
-            require(clean.contains("not have enough", ignoreCase = true) || clean.contains("insufficient", ignoreCase = true)) {
-                "No verified official passages were available for this answer."
+            require(insufficient) { "No verified official passages were available for this answer." }
+            require(markerNumbers.isEmpty()) { "An answer without verified passages cannot cite a source." }
+        } else if (insufficient) {
+            require(markerNumbers.isEmpty()) { "An insufficient-source response cannot attach citations." }
+        } else {
+            require(markerNumbers.isNotEmpty()) {
+                "The local AI did not identify which verified excerpts it actually used."
+            }
+            require(markerNumbers.all { it in 1..passages.size }) {
+                "The local AI referenced a source outside the verified excerpt set."
             }
         }
-        return clean
+
+        val displayBody = clean
+            .replace(sourceMarker, "")
+            .replace(Regex("[ \t]+(?=\n)"), "")
+            .replace(Regex(" {2,}"), " ")
+            .replace(Regex("\n{3,}"), "\n\n")
+            .trim()
+        require(displayBody.length >= 20) { "The local AI returned an incomplete answer after source validation." }
+
+        return GroundedAiAnswer(
+            body = displayBody,
+            usedPassageIndexes = markerNumbers.distinct().map { it - 1 },
+        )
     }
 }
