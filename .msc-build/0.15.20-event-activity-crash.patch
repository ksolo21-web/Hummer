+private inline fun <T> loadWorkbookAssetSafely(loader: () -> T): T? = try {
+    loader()
+} catch (_: Exception) {
+    null
+}
+
+private fun loadTransparentLineBitmap(context: android.content.Context, path: String): Bitmap {
+    val source = loadAssetBitmap(context, path)
+    return try {
+        transparentLineBitmap(source)
+    } finally {
+        source.recycle()
+    }
+}
