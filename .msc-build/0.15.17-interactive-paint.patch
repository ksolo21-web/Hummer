+private fun clampWorkbookPan(pan: Offset, zoom: Float, viewport: IntSize): Offset {
+    if (zoom <= 1f || viewport.width <= 0 || viewport.height <= 0) return Offset.Zero
+    val maxX = viewport.width * (zoom - 1f) / 2f
+    val maxY = viewport.height * (zoom - 1f) / 2f
+    return Offset(
+        x = pan.x.coerceIn(-maxX, maxX),
+        y = pan.y.coerceIn(-maxY, maxY),
+    )
+}
+
+private fun inverseWorkbookPoint(
+    tapped: Offset,
+    viewport: IntSize,
+    zoom: Float,
+    pan: Offset,
+): Offset? {
+    if (viewport.width <= 0 || viewport.height <= 0 || zoom <= 0f) return null
+    val center = Offset(viewport.width / 2f, viewport.height / 2f)
+    val mapped = center + (tapped - center - pan) / zoom
+    return mapped.takeIf {
+        it.x in 0f..viewport.width.toFloat() && it.y in 0f..viewport.height.toFloat()
+    }
+}
+
+private fun workbookMilestone(completed: Int, total: Int): Int {
+    if (total <= 0 || completed <= 0) return 0
+    val percent = completed * 100 / total
+    return when {
+        completed >= total -> 100
+        percent >= 75 -> 75
+        percent >= 50 -> 50
+        percent >= 25 -> 25
+        else -> 0
+    }
+}
