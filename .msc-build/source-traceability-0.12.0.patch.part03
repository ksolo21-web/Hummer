diff --git a/app/src/test/java/com/mystudycompanion/app/ai/runtime/GuidedOfflineStudyProviderTest.kt b/app/src/test/java/com/mystudycompanion/app/ai/runtime/GuidedOfflineStudyProviderTest.kt
new file mode 100644
index 0000000..e5a202b
--- /dev/null
+++ b/app/src/test/java/com/mystudycompanion/app/ai/runtime/GuidedOfflineStudyProviderTest.kt
@@ -0,0 +1,19 @@
+package com.mystudycompanion.app.ai.runtime
+
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class GuidedOfflineStudyProviderTest {
+    @Test
+    fun identifiesEveryExcerptItActuallyUses() = runBlocking {
+        val answer = GuidedOfflineStudyProvider().generate(
+            """
+            <source id="1" title="First" heading="One">First verified excerpt.</source>
+            <source id="2" title="Second" heading="Two">Second verified excerpt.</source>
+            """.trimIndent(),
+        )
+        assertTrue(answer.contains("[[source:1]]"))
+        assertTrue(answer.contains("[[source:2]]"))
+    }
+}
