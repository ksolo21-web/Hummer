+                listOf(source),
+            )
+        }
+    }
+
+    @Test
+    fun insufficientAnswerDoesNotAttachCitation() {
+        val result = AiGroundingValidator.validateAndResolve(
+            "I do not have enough verified material stored to answer this safely.",
+            listOf(source),
+        )
+        assertEquals(emptyList<Int>(), result.usedPassageIndexes)
+    }
 }
