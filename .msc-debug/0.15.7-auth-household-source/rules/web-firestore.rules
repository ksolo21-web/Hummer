rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function ideaPath(householdId, ideaId) {
      return /databases/$(database)/documents/households/$(householdId)/ideas/$(ideaId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/householdInvites/$(code);
    }

    function member(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function memberAfter(householdId) {
      return signedIn() && existsAfter(memberPath(householdId, request.auth.uid));
    }

    function role(householdId) {
      return get(memberPath(householdId, request.auth.uid)).data.role;
    }

    function owner(householdId) {
      return member(householdId) && role(householdId) == 'owner';
    }

    function organizer(householdId) {
      return member(householdId) && role(householdId) in ['owner', 'organizer'];
    }

    function validRole(value) {
      return value in ['owner', 'organizer', 'member'];
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function validCloudKey(value, maximumLength) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= maximumLength &&
        value.matches('[A-Za-z0-9._:@-]+');
    }

    function validOfficialUrl(value) {
      return value is string && (
        value == '' ||
        value.matches('https://(www\\.|wol\\.)?jw\\.org(/.*)?')
      );
    }

    function noOtherHousehold(uid, householdId) {
      return !exists(userPath(uid)) ||
        !('householdId' in get(userPath(uid)).data) ||
        get(userPath(uid)).data.householdId == '' ||
        get(userPath(uid)).data.householdId == householdId;
    }

    function validOwnUserLink(uid) {
      let householdId = request.resource.data.householdId;
      return householdId is string && householdId.size() > 0 &&
        existsAfter(memberPath(householdId, uid)) &&
        getAfter(memberPath(householdId, uid)).data.uid == uid &&
        getAfter(memberPath(householdId, uid)).data.role == request.resource.data.role;
    }

    function validUserDocument(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'householdId', 'role', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        validDisplayName(request.resource.data.displayName) &&
        validRole(request.resource.data.role) &&
        request.resource.data.updatedAt == request.time &&
        validOwnUserLink(uid);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        validUserDocument(uid);
      allow update: if signedIn() && request.auth.uid == uid &&
        (
          request.resource.data.householdId == resource.data.householdId ||
          (
            (!('householdId' in resource.data) || resource.data.householdId == '') &&
            request.resource.data.householdId.size() > 0
          )
        ) &&
        validUserDocument(uid);
      // A standalone user-link deletion would leave an orphaned member document.
      allow delete: if false;
    }

    match /households/{householdId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'familyName', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.familyName is string &&
        request.resource.data.familyName.size() > 0 &&
        request.resource.data.familyName.size() <= 60 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow read: if member(householdId);
      allow update: if organizer(householdId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'familyName', 'updatedAt'
        ]) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.familyName is string &&
        request.resource.data.familyName.size() > 0 &&
        request.resource.data.familyName.size() <= 60 &&
        request.resource.data.updatedAt == request.time;
      // Firestore does not cascade-delete subcollections. Household deletion is
      // disabled until a complete administrative cleanup flow exists.
      allow delete: if false;

      match /members/{uid} {
        allow read: if member(householdId);
        allow create: if signedIn() &&
          noOtherHousehold(uid, householdId) &&
          request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'ageGroup', 'role', 'googleConnected',
            'inviteCode', 'joinedAt', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          validDisplayName(request.resource.data.displayName) &&
          request.resource.data.ageGroup in ['CHILD', 'PRETEEN', 'TEEN', 'ADULT'] &&
          request.resource.data.googleConnected is bool &&
          request.resource.data.joinedAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          (
            (
              uid == request.auth.uid &&
              request.resource.data.role == 'owner' &&
              request.resource.data.inviteCode == '' &&
              getAfter(householdPath(householdId)).data.ownerUid == request.auth.uid
            ) ||
            (
              uid == request.auth.uid &&
              request.resource.data.role == 'member' &&
              request.resource.data.inviteCode is string &&
              request.resource.data.inviteCode.size() >= 6 &&
              getAfter(invitePath(request.resource.data.inviteCode)).data.householdId == householdId &&
              getAfter(invitePath(request.resource.data.inviteCode)).data.status == 'used' &&
              getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == request.auth.uid
            )
          );
        allow update: if member(householdId) && (
          (
            request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'ageGroup', 'googleConnected', 'updatedAt'
            ]) &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.inviteCode == resource.data.inviteCode &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            validDisplayName(request.resource.data.displayName) &&
            request.resource.data.ageGroup in ['CHILD', 'PRETEEN', 'TEEN', 'ADULT'] &&
            request.resource.data.googleConnected is bool &&
            request.resource.data.updatedAt == request.time
          ) ||
          (
            owner(householdId) &&
            uid != request.auth.uid &&
            resource.data.role != 'owner' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role', 'updatedAt'
            ]) &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.role in ['organizer', 'member'] &&
            request.resource.data.updatedAt == request.time
          )
        );
        // Membership removal needs an atomic user-link cleanup flow. Disable it
        // rather than allowing stale or partially detached household identities.
        allow delete: if false;
      }

      match /shared/{documentId} {
        allow read: if member(householdId);
        allow create: if (organizer(householdId) || (
          memberAfter(householdId) &&
          getAfter(memberPath(householdId, request.auth.uid)).data.role == 'owner'
        )) &&
          documentId == 'familyBoard' &&
          request.resource.data.keys().hasOnly([
            'payloadJson', 'revision', 'updatedBy', 'updatedAt'
          ]) &&
          request.resource.data.payloadJson is string &&
          request.resource.data.payloadJson.size() <= 100000 &&
          request.resource.data.revision is int &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
        allow update: if organizer(householdId) &&
          documentId == 'familyBoard' &&
          request.resource.data.keys().hasOnly([
            'payloadJson', 'revision', 'updatedBy', 'updatedAt'
          ]) &&
          request.resource.data.payloadJson is string &&
          request.resource.data.payloadJson.size() <= 100000 &&
          request.resource.data.revision is int &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /ideas/{ideaId} {
        allow read: if member(householdId);
        allow create: if (member(householdId) || memberAfter(householdId)) &&
          validCloudKey(ideaId, 160) &&
          request.resource.data.keys().hasOnly([
            'id', 'createdByUid', 'authorUid', 'authorName', 'topic', 'reason', 'scripture',
            'officialUrl', 'createdAtEpochMillis', 'used', 'updatedAt'
          ]) &&
          request.resource.data.id == ideaId &&
          request.resource.data.createdByUid == request.auth.uid &&
          validCloudKey(request.resource.data.authorUid, 160) &&
          validDisplayName(request.resource.data.authorName) &&
          request.resource.data.topic is string &&
          request.resource.data.topic.size() >= 3 &&
          request.resource.data.topic.size() <= 160 &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() <= 300 &&
          request.resource.data.scripture is string &&
          request.resource.data.scripture.size() <= 80 &&
          validOfficialUrl(request.resource.data.officialUrl) &&
          request.resource.data.createdAtEpochMillis is int &&
          request.resource.data.createdAtEpochMillis > 0 &&
          request.resource.data.used == false &&
          request.resource.data.updatedAt == request.time;
        allow update: if member(householdId) && (
          (
            resource.data.createdByUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'topic', 'reason', 'scripture', 'officialUrl', 'updatedAt'
            ]) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.createdByUid == resource.data.createdByUid &&
            request.resource.data.authorUid == resource.data.authorUid &&
            request.resource.data.createdAtEpochMillis == resource.data.createdAtEpochMillis &&
            request.resource.data.used == resource.data.used &&
            validDisplayName(request.resource.data.authorName) &&
            request.resource.data.topic is string &&
            request.resource.data.topic.size() >= 3 &&
            request.resource.data.topic.size() <= 160 &&
            request.resource.data.reason is string &&
            request.resource.data.reason.size() <= 300 &&
            request.resource.data.scripture is string &&
            request.resource.data.scripture.size() <= 80 &&
            validOfficialUrl(request.resource.data.officialUrl) &&
            request.resource.data.updatedAt == request.time
          ) ||
          (
            organizer(householdId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'used', 'updatedAt'
            ]) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.createdByUid == resource.data.createdByUid &&
            request.resource.data.authorUid == resource.data.authorUid &&
            request.resource.data.used is bool &&
            request.resource.data.updatedAt == request.time
          )
        );
        // Idea deletion would require deleting its vote documents as well.
        allow delete: if false;
      }

      match /ideaVotes/{voteId} {
        allow read: if member(householdId);
        allow create: if (member(householdId) || memberAfter(householdId)) &&
          request.resource.data.keys().hasOnly([
            'ideaId', 'voterUid', 'createdByUid', 'createdAt'
          ]) &&
          validCloudKey(request.resource.data.ideaId, 160) &&
          validCloudKey(request.resource.data.voterUid, 160) &&
          voteId == 'vote-' + request.auth.uid + '-' + request.resource.data.ideaId + '-' + request.resource.data.voterUid &&
          exists(ideaPath(householdId, request.resource.data.ideaId)) &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if member(householdId) &&
          resource.data.createdByUid == request.auth.uid;
      }

      match /memberProgress/{uid} {
        allow read: if member(householdId);
        allow create, update: if signedIn() && request.auth.uid == uid &&
          (member(householdId) || memberAfter(householdId)) &&
          request.resource.data.keys().hasOnly([
            'uid', 'payloadJson', 'revision', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          request.resource.data.payloadJson is string &&
          request.resource.data.payloadJson.size() <= 200000 &&
          request.resource.data.revision is int &&
          request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid && member(householdId);
      }

      // Interactive workbook pages are stored separately so drawings, coloring,
      // handwriting, and puzzles never overfill the general progress document.
      match /memberWorkbooks/{accountUid} {
        allow read: if member(householdId);
        allow create, update, delete: if false;

        match /pages/{pageId} {
          allow read: if member(householdId);
          allow create, update: if signedIn() && request.auth.uid == accountUid &&
            (member(householdId) || memberAfter(householdId)) &&
            validCloudKey(pageId, 64) &&
            request.resource.data.keys().hasOnly([
              'accountUid', 'profileUid', 'pageKey', 'payloadJson',
              'revision', 'updatedAt'
            ]) &&
            request.resource.data.accountUid == accountUid &&
            validCloudKey(request.resource.data.profileUid, 160) &&
            request.resource.data.pageKey is string &&
            request.resource.data.pageKey.size() > 0 &&
            request.resource.data.pageKey.size() <= 240 &&
            request.resource.data.payloadJson is string &&
            request.resource.data.payloadJson.size() <= 700000 &&
            request.resource.data.revision is int &&
            request.resource.data.updatedAt == request.time;
          allow delete: if signedIn() && request.auth.uid == accountUid &&
            member(householdId);
        }
      }

      // Full-text Daily Text, Watchtower, scripture, meeting, and other
      // official study materials are stored one document at a time. This keeps
      // paragraph notes and reading position synchronized without overfilling
      // the general member-progress document.
      match /memberStudyMaterials/{accountUid} {
        // Paragraph notes are private to the signed-in account. They synchronize
        // across that account's phone, tablet, browser, and wearable handoff,
        // but are not exposed to other household members by default.
        allow read: if signedIn() && request.auth.uid == accountUid && member(householdId);
        allow create, update, delete: if false;

        match /documents/{materialId} {
          allow read: if signedIn() && request.auth.uid == accountUid && member(householdId);
          allow create, update: if signedIn() && request.auth.uid == accountUid &&
            (member(householdId) || memberAfter(householdId)) &&
            validCloudKey(materialId, 64) &&
            request.resource.data.keys().hasOnly([
              'accountUid', 'profileUid', 'documentId', 'sourceUrl',
              'payloadJson', 'revision', 'updatedAt'
            ]) &&
            request.resource.data.accountUid == accountUid &&
            validCloudKey(request.resource.data.profileUid, 160) &&
            request.resource.data.documentId is string &&
            request.resource.data.documentId.size() > 0 &&
            request.resource.data.documentId.size() <= 240 &&
            validOfficialUrl(request.resource.data.sourceUrl) &&
            request.resource.data.payloadJson is string &&
            request.resource.data.payloadJson.size() <= 700000 &&
            request.resource.data.revision is int &&
            request.resource.data.updatedAt == request.time;
          allow delete: if signedIn() && request.auth.uid == accountUid &&
            member(householdId);
        }
      }

      match /familyWorship/{documentId} {
        allow read: if member(householdId);
        allow create, update: if organizer(householdId) &&
          documentId == 'current' &&
          request.resource.data.keys().hasOnly([
            'payloadJson', 'revision', 'updatedBy', 'updatedAt'
          ]) &&
          request.resource.data.payloadJson is string &&
          request.resource.data.payloadJson.size() <= 250000 &&
          request.resource.data.revision is int &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
        allow delete: if organizer(householdId) && documentId == 'current';
      }
    }

    match /householdInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'householdId', 'createdBy', 'createdAt', 'expiresAtEpochSeconds',
          'expiresAt', 'status', 'usedBy'
        ]) &&
        request.resource.data.householdId is string &&
        organizer(request.resource.data.householdId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(24, 'h') &&
        request.resource.data.expiresAtEpochSeconds is int &&
        request.resource.data.status == 'active' &&
        request.resource.data.usedBy == '';
      allow update: if signedIn() && (
        (
          organizer(resource.data.householdId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status'
          ]) &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'cancelled'
        ) ||
        (
          resource.data.status == 'active' &&
          request.time < resource.data.expiresAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'usedBy', 'usedAt'
          ]) &&
          request.resource.data.status == 'used' &&
          request.resource.data.usedBy == request.auth.uid &&
          request.resource.data.usedAt == request.time &&
          existsAfter(memberPath(resource.data.householdId, request.auth.uid)) &&
          getAfter(memberPath(resource.data.householdId, request.auth.uid)).data.inviteCode == code
        )
      );
      // Preserve the invitation audit trail; organizers cancel rather than delete.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
