+package com.koenterprises.territorycardstudio
+
+import android.graphics.Bitmap
+import android.graphics.pdf.PdfRenderer
+import android.os.ParcelFileDescriptor
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.koenterprises.territorycardstudio.core.BundleIntegrity
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+
+@RunWith(AndroidJUnit4::class)
+class MapOcrRecoveryInstrumentationTest {
+    private fun referenceMap():File {
+        val instrumentation=InstrumentationRegistry.getInstrumentation()
+        val context=instrumentation.targetContext
+        val pdf=File(context.cacheDir,"ocr-recovery-reference.pdf")
+        val png=File(context.cacheDir,"ocr-recovery-reference.png")
+        instrumentation.context.assets.open("reference300.pdf").use {input->pdf.outputStream().use {input.copyTo(it)}}
+        PdfRenderer(ParcelFileDescriptor.open(pdf,ParcelFileDescriptor.MODE_READ_ONLY)).use {renderer->
+            renderer.openPage(0).use {page->
+                val scale=minOf(1400.0/page.width,1400.0/page.height)
+                val bitmap=Bitmap.createBitmap((page.width*scale).toInt(),(page.height*scale).toInt(),Bitmap.Config.ARGB_8888)
+                bitmap.eraseColor(android.graphics.Color.WHITE)
+                page.render(bitmap,null,null,PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
+                png.outputStream().use {check(bitmap.compress(Bitmap.CompressFormat.PNG,100,it))}
+                bitmap.recycle()
+            }
+        }
+        pdf.delete()
+        return png
+    }
+
+    @Test fun transientInternalOcrFailureRetriesAndStillReadsTheMap() {
+        val source=referenceMap()
+        try {
+            val sha=source.inputStream().use(BundleIntegrity::sha256)
+            var attempts=0
+            val result=AndroidMapImageInterpreter {
+                attempts++
+                if(attempts==1)throw NullPointerException("synthetic ML Kit internal null")
+            }.interpret(source,sha)
+            assertTrue("OCR was not retried",attempts>=2)
+            assertTrue("Road geometry should survive an OCR retry",result.roads.isNotEmpty())
+            assertTrue("The successful retry should still return labels",result.recognizedText.isNotEmpty())
+        } finally {source.delete()}
+    }
+
+    @Test fun persistentInternalOcrFailureFallsBackToGeometryInsteadOfAborting() {
+        val source=referenceMap()
+        try {
+            val sha=source.inputStream().use(BundleIntegrity::sha256)
+            var attempts=0
+            val result=AndroidMapImageInterpreter {
+                attempts++
+                throw NullPointerException("synthetic ML Kit internal null")
+            }.interpret(source,sha)
+            assertTrue("Two OCR attempts are required before fallback",attempts>=2)
+            assertTrue("Color/road geometry must still be extracted without OCR",result.roads.isNotEmpty())
+            assertTrue("Failed OCR must not invent text",result.recognizedText.isEmpty())
+            assertTrue("Missing labels must remain explicit review items",result.findings.any {it.id.startsWith("name-")})
+        } finally {source.delete()}
+    }
+
+    @Test fun unexpectedReaderExceptionsAreNeverRenderedAsRawSdkErrors() {
+        val message=friendlyMapReadFailure()
+        assertFalse(message.contains("null object reference",ignoreCase=true))
+        assertFalse(message.contains("java.",ignoreCase=true))
+        assertFalse(message.contains("com.google",ignoreCase=true))
+        assertTrue(message.contains("map is still saved",ignoreCase=true))
+    }
+}
