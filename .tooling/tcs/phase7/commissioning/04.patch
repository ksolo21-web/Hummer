+        File(i.targetContext.filesDir,"phase7-commissioning-$name-$viewport.png").outputStream().use {
+            assertTrue(image.compress(android.graphics.Bitmap.CompressFormat.PNG,100,it))
+        };image.recycle()
+    }
+    @Test fun actualA265DraftPersistsInIsolatedServicesAndOriginalApprovalIsUntouched()=Fixture().use {x->
+        val originalAssignment=x.slot.copy();val originalExport=x.app.services.approvedExport.state(ID)
+        assertTrue(runCatching {x.app.services.nativeDrafts.save(x.pending(x.baseline),null)}.isFailure)
+        val scope=x.start();val services=x.services(scope)
+        val current=services.knowledgeBase.assignments.getValue(ID)
+        assertTrue(current.needsNewCard);assertFalse(current.fieldReleaseAllowedForExactArtifact)
+        assertEquals(originalAssignment,x.app.services.knowledgeBase.assignments.getValue(ID))
+        assertEquals(originalExport,x.app.services.approvedExport.state(ID))
+        assertFalse(services.approvedExport.state(ID).canAttach)
+        val saved=services.nativeDrafts.save(x.pending(services.knowledgeBase),null)
+        val reopened=AndroidCommissioningStore(x.app,x.baseline,x.root,x.sources)
+        val resumed=x.services(requireNotNull(reopened.current(ID)),reopened)
+        assertEquals(saved,resumed.nativeDrafts.read(ID,WorkspaceMode.REGULAR))
+        assertTrue(runCatching {resumed.nativeDrafts.register(ID,WorkspaceMode.REGULAR,saved.revisionSha256)}.isFailure)
+        assertFalse(resumed.buildWorkflow.state(ID,WorkspaceMode.REGULAR).canBuild)
+        assertTrue(resumed.buildWorkflow.state(ID,WorkspaceMode.REGULAR).buildBlockers.none {it.contains("requires the commissioning workflow")})
+        val archive=File(x.root,"native-history.zip")
+        val received=resumed.nativeDrafts.exportHistory(object:CreatedExportDestination {
+            override fun openOutput()=archive.outputStream()
+            override fun openInput()=archive.inputStream()
+            override fun deleteCreated()=archive.delete()
+        })
+        assertEquals(received,archive.inputStream().use(BundleIntegrity::sha256))
+        ZipFile(archive).use {zip->
+            val entry=requireNotNull(zip.getEntry("commissioning-evidence.source"))
+            val evidence=zip.getInputStream(entry).use {JSONObject(it.readBytes().toString(Charsets.UTF_8))}
+            assertEquals(scope.sha256,evidence.getString("scopeSha256"))
+            assertTrue(evidence.getString("purpose").contains("not assignment activation"))
+        }
+        report("persistence",JSONObject().put("originalAssignmentUnchanged",true).put("originalExportUnchanged",true)
+            .put("exactNativeDraftResumed",true).put("commissioningEvidenceSavedAndReadBack",true).put("registrationStillBlocked",true))
+    }
+    @Test fun staleSourceScopeOrRevisionCannotBeReusedByTheOldCandidate()=Fixture().use {x->
+        val first=x.start();val services=x.services(first);val saved=services.nativeDrafts.save(x.pending(services.knowledgeBase),null)
+        val guarded=services.sourceMapStore()
+        assertEquals(HASH,guarded.verifiedRecord(ID)?.sha256)
+        x.sources.importFromStream(x.slot,"different-source.jpg","image/jpeg",InstrumentationRegistry.getInstrumentation().context.assets.open("phase7-01-26588.jpg"))
+        assertTrue(runCatching {x.store.current(ID)}.isFailure)
+        assertTrue(runCatching {guarded.verifiedRecord(ID)}.isFailure)
+        assertTrue(runCatching {services.nativeDrafts.save(saved,saved.revisionSha256)}.isFailure)
+        assertFalse(services.buildWorkflow.state(ID,WorkspaceMode.REGULAR).canBuild)
+        x.importExact()
+        val previousHead=requireNotNull(x.store.headSha256(ID));val second=x.start(head=previousHead)
+        assertNotEquals(first.sha256,second.sha256)
+        assertTrue(runCatching {x.store.assertCurrent(first)}.isFailure)
+        assertTrue(runCatching {guarded.verifiedRecord(ID)}.isFailure)
+        assertTrue(runCatching {x.start(head=previousHead)}.isFailure)
+        val newServices=x.services(second)
+        assertNull(newServices.nativeDrafts.read(ID,WorkspaceMode.REGULAR))
+        val newSaved=newServices.nativeDrafts.save(x.pending(newServices.knowledgeBase),null)
+        x.store.close(ID,"Instrumentation reviewer",requireNotNull(x.store.headSha256(ID)))
+        assertNull(x.store.current(ID))
+        assertTrue(runCatching {newServices.nativeDrafts.save(newSaved,newSaved.revisionSha256)}.isFailure)
+        assertFalse(newServices.buildWorkflow.state(ID,WorkspaceMode.REGULAR).canBuild)
+        assertEquals(x.slot,x.app.services.knowledgeBase.assignments.getValue(ID))
+        report("invalidation",JSONObject().put("sourceReplacementRejected",true).put("oldScopeRejected",true).put("staleHeadRejected",true)
+            .put("newScopeHasSeparateDrafts",true).put("closedScopeCannotSaveOrBuild",true))
+    }
+    @Test fun identityAndOriginalPreservationAreRequiredAndExactOldPdfIsNotNewAuthority()=Fixture().use {x->
