+        fun importExact()=sources.importFromStream(slot,"real-a265.jpg","image/jpeg",
+            InstrumentationRegistry.getInstrumentation().context.assets.open("phase7-03-26175.jpg")).also {assertEquals(HASH,it.sha256)}
+        fun start(store:AndroidCommissioningStore=this.store,head:String?=store.headSha256(ID))=store.start(ID,HASH,"Instrumentation reviewer",
+            "Test-only same-territory candidate: exact supplied image identifies A265; no field approval",ID,true,head)
+        fun services(scope:NativeCommissioningScope,store:AndroidCommissioningStore=this.store):TerritoryCardStudioServices {
+            candidateRoots+=File(app.noBackupFilesDir,"territory-card-studio/commissioned/${scope.sha256}")
+            return TerritoryCardStudioServices(app,scope,store)
+        }
+        fun pending(kb:TerritoryKnowledgeBase):NativeAuthoringDraft {
+            val slot=kb.assignments.getValue(ID);val review=OutlinedNativeReview.from(draft)
+            val assignment=CurrentAuthoritativeAssignmentState(ID,slot.identity,slot.canonicalFilename,kb.revision,"current_authoritative_assignment","0".repeat(64),
+                "real-a265.jpg","Rochester","9/28/2026",listOf("Directions: Test-only source intake; not for field use."),"full_map",slot.housingType,
