+        evidence.writeText("{}");assertTrue(runCatching {x.store.current(ID)}.isFailure)
+        evidence.writeBytes(original);assertEquals(scope.sha256,x.store.current(ID)?.sha256)
+        val event=x.root.walkTopDown().single {it.name==requireNotNull(currentHead)+".event"}
