+        private lateinit var draft:InterpretedMapDraft
+        @JvmStatic @BeforeClass fun analyzeExactSourceOnce() {
+            val app=ApplicationProvider.getApplicationContext<TerritoryCardStudioApplication>()
+            val file=File.createTempFile("commissioning-source-",".jpg",app.cacheDir)
+            try {
+                InstrumentationRegistry.getInstrumentation().context.assets.open("phase7-03-26175.jpg").use {input->file.outputStream().use {input.copyTo(it)}}
+                draft=AndroidMapImageInterpreter().interpretOutlined(file,HASH)
+            } finally {file.delete()}
+        }
+    }
+    private val viewport get()=InstrumentationRegistry.getArguments().getString("phase7Viewport","phone")
+    private inner class Fixture:AutoCloseable {
+        val app=ApplicationProvider.getApplicationContext<TerritoryCardStudioApplication>()
+        val baseline=app.services.knowledgeBase
+        val slot=baseline.assignments.getValue(ID)
+        val sources=SourceMapIntakeStore(app)
+        private val previous=sources.verifiedRecord(ID)
+        private val previousBytes=previous?.let {sources.verifiedFile(ID).readBytes()}
+        val root=File(app.cacheDir,"commissioning-test-${UUID.randomUUID()}").apply {mkdirs()}
+        val store=AndroidCommissioningStore(app,baseline,root,sources)
+        val candidateRoots=mutableListOf<File>()
