+package com.koenterprises.territorycardstudio
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.unit.dp
+import com.koenterprises.territorycardstudio.core.*
+import java.io.File
+
+/** This confirmation only opens an isolated draft. It never confirms coverage or work facts. */
+@Composable internal fun NativeCommissioningAuthorizationPanel(assignment:KnowledgeBaseAssignment,
+    source:File?,sourceSha256:String?,onConfirm:(String,String,String,Boolean)->Unit) {
+    key(assignment.displayId,source?.path,sourceSha256) {
+        var actor by remember {mutableStateOf("")}
+        var reason by remember {mutableStateOf("")}
+        var identity by remember {mutableStateOf("")}
+        var preserve by remember {mutableStateOf(false)}
+        var readable by remember {mutableStateOf(false)}
+        var inspected by remember(actor,reason,identity) {mutableStateOf(false)}
+        Text("Create a replacement candidate",style=MaterialTheme.typography.headlineSmall)
+        Text("Original territory: ${assignment.displayId}",modifier=Modifier.testTag("commissioning-original-id"))
+        Text("The original card and installed catalog will stay unchanged. The replacement has separate drafts, reviews and approvals.")
+        Text("Original reference: ${assignment.referenceSha256.take(16)}…")
+        val names=assignment.roadNameInventory.distinct()
+        if(names.isNotEmpty())Text("Original catalog streets: "+names.take(20).joinToString(", ")+(if(names.size>20)" …" else ""))
+        if(source!=null && sourceSha256!=null) {
+            Box(Modifier.testTag("commissioning-source-preview")) {
+                NativeSourcePreview(source) {shown->
+                    readable=shown && runCatching {source.inputStream().use(BundleIntegrity::sha256)==sourceSha256}.getOrDefault(false)
+                }
+            }
+        } else Text("Import the new source map before opening a replacement workspace.",color=MaterialTheme.colorScheme.error)
+        Text("An unclear boundary or conflicting territory number is not resolved by this step. Source reconciliation and the full card review remain mandatory.")
+        OutlinedTextField(actor,{actor=it},label={Text("Reviewer name")},modifier=Modifier.fillMaxWidth().testTag("commissioning-actor"))
+        OutlinedTextField(identity,{identity=it},label={Text("Type ${assignment.displayId} to confirm the same territory")},modifier=Modifier.fillMaxWidth().testTag("commissioning-identity"))
+        OutlinedTextField(reason,{reason=it},label={Text("Evidence that this new source belongs to this territory")},modifier=Modifier.fillMaxWidth().testTag("commissioning-reason"))
+        Row {Checkbox(inspected,{inspected=it},enabled=readable,modifier=Modifier.testTag("commissioning-source-inspected"));Text("I inspected this exact new source and confirmed its territory identity",Modifier.weight(1f).padding(top=12.dp))}
+        Row {Checkbox(preserve,{preserve=it},modifier=Modifier.testTag("commissioning-preserve-original"));Text("Keep the original card unchanged; create an unapproved replacement candidate",Modifier.weight(1f).padding(top=12.dp))}
+        Button(onClick={onConfirm(actor.trim(),reason.trim(),identity,preserve)},
+            enabled=readable && inspected && preserve && identity==assignment.displayId && actor.trim().length in 1..120 && reason.trim().length in 8..2000,
+            modifier=Modifier.fillMaxWidth().testTag("commissioning-start")){Text("Open separate candidate workspace")}
+    }
+}
+
+@Composable internal fun NativeCommissioningWorkflowScreen(modifier:Modifier,item:TerritoryDashboardItem,
+    baseline:TerritoryKnowledgeBase,onImportSource:()->Unit,onBack:()->Unit) {
+    val context=LocalContext.current
+    val store=remember(context,baseline){AndroidCommissioningStore(context,baseline)}
+    val sources=remember(context){SourceMapIntakeStore(context)}
+    val id=item.assignment.displayId
+    var refresh by remember(id){mutableStateOf(0)}
+    var selected by remember(id){mutableStateOf<NativeCommissioningScope?>(null)}
+    var recorded by remember(id){mutableStateOf<NativeCommissioningScope?>(null)}
+    var head by remember(id){mutableStateOf<String?>(null)}
+    var message by remember(id){mutableStateOf("")}
+    var closeConfirmation by remember(id){mutableStateOf(false)}
+    var loaded by remember(id){mutableStateOf(false)}
+    LaunchedEffect(id,refresh) {
+        loaded=false
+        runCatching {head=store.headSha256(id);recorded=store.recordedScope(id)}
+            .onFailure {message=it.message.orEmpty()}
+        loaded=true
+    }
+    selected?.let {scope->
+        val result=remember(scope.sha256){runCatching {TerritoryCardStudioServices(context,scope,store)}}
+        val services=result.getOrNull()
+        if(services==null) {
+            Column(modifier.padding(20.dp)) {Text(result.exceptionOrNull()?.message ?: "Candidate workspace unavailable");TextButton(onClick={selected=null;refresh++}){Text("Return to commissioning review")}}
+        } else {
+            val candidate=item.copy(assignment=services.knowledgeBase.assignments.getValue(id),status=TerritoryUiStatus.NEEDS_NEW_CARD)
+            Column(modifier.fillMaxSize()) {
+                Surface(tonalElevation=2.dp) {Column(Modifier.fillMaxWidth().padding(horizontal=16.dp,vertical=8.dp)) {
+                    Text("Replacement candidate · original preserved",style=MaterialTheme.typography.titleSmall,modifier=Modifier.testTag("commissioning-candidate-banner"))
+                    Text("Separate workspace ${scope.sha256.take(12)}",style=MaterialTheme.typography.bodySmall)
+                }}
+                key(scope.sha256) {ModeAwareTerritoryWorkspace(Modifier.weight(1f),candidate,services.knowledgeBase.revision,
+                    onBack={selected=null;refresh++},knowledgeBase=services.knowledgeBase,servicesOverride=services)}
+            }
+        }
+        return
+    }
+    val source=remember(id,refresh){runCatching {sources.verifiedRecord(id)}.getOrNull()}
+    val file=remember(source){source?.let {runCatching {sources.verifiedFile(id)}.getOrNull()}}
+    Column(modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(20.dp),verticalArrangement=Arrangement.spacedBy(12.dp)) {
+        TextButton(onClick=onBack){Text("← Original territory")}
+        Text(message,modifier=Modifier.testTag("commissioning-status"))
+        recorded?.let {scope->
+            Text("A separate candidate workspace is retained. It is not the original approved card.")
+            Button(onClick={runCatching {store.assertCurrent(scope);selected=scope}.onFailure {message=it.message.orEmpty()}},modifier=Modifier.fillMaxWidth().testTag("commissioning-resume")){Text("Resume retained candidate")}
+            TextButton(onClick={closeConfirmation=true},modifier=Modifier.testTag("commissioning-close")){Text("Close this candidate workspace")}
+        }
+        OutlinedButton(onClick=onImportSource,modifier=Modifier.fillMaxWidth()){Text("Choose or change the new source map")}
+        if(loaded)NativeCommissioningAuthorizationPanel(item.assignment,file,source?.sha256) {actor,reason,identity,preserve->
+            runCatching {store.start(id,requireNotNull(source).sha256,actor,reason,identity,preserve,head)}
+                .onSuccess {selected=it;message="Separate candidate opened. The original is unchanged."}
+                .onFailure {message=it.message.orEmpty()}
+        } else CircularProgressIndicator()
+    }
+    if(closeConfirmation)AlertDialog(onDismissRequest={closeConfirmation=false},title={Text("Close this candidate?")},
+        text={Text("The original card and all saved evidence stay unchanged. This candidate will no longer be eligible for building or export. A later replacement needs a new commissioning review.")},
+        confirmButton={TextButton(onClick={
+            runCatching {store.close(id,requireNotNull(recorded).actor,requireNotNull(head))}
+                .onSuccess {recorded=null;message="Candidate workspace closed. The original card and evidence were retained.";refresh++}
+                .onFailure {message=it.message.orEmpty()}
+            closeConfirmation=false
+        }){Text("Close candidate")}},dismissButton={TextButton(onClick={closeConfirmation=false}){Text("Keep open")}})
+}
