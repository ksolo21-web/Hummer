+        val slot=kb.assignments.getValue(id)
+        val root=java.nio.file.Files.createTempDirectory("outlined-commissioning-test-only").toFile()
+        var currentSource:String?="b".repeat(64)
+        val road=RoadGeometry("TEST-alpha","Alpha Rd","alpha rd","context","context","",false,"termination","termination",4.0,
+            listOf(Point2D(250.0,140.0),Point2D(550.0,140.0)))
+        val building=BuildingGeometry("TEST-building","99999",slot.housingType,true,"",listOf("99999"),emptyList(),
+            listOf(Point2D(310.0,170.0),Point2D(350.0,170.0),Point2D(350.0,210.0),Point2D(310.0,210.0)))
+        val assignment=CurrentAuthoritativeAssignmentState(id,slot.identity,slot.canonicalFilename,kb.revision,"current_authoritative_assignment","0".repeat(64),
+            "SYNTHETIC CORE REGRESSION - NOT A TERRITORY CARD","TEST ONLY","9/28/2026",listOf("Directions: Synthetic native-role regression only."),"full_map",
+            slot.housingType,RenderCoordinateSpace.LOCKED_R48_PAGE_POINTS_TOP_ORIGIN,listOf(road),listOf(building))
+        val facts=NativeSourceReconciliation(id,"REGULAR",kb.revision,requireNotNull(currentSource),slot.referenceSha256,"current_assignment_map","Synthetic reviewer",
+            "2026-09-28T21:00:00Z",NativeSourceReconciliationContract.assignmentContentSha256(assignment),null,true,true,false,false,
+            listOf(SourceSegmentObservation(road.segmentId,road.name,road.status,road.role,road.insideSide,road.accessOnly,road.endpointAKind,road.endpointBKind,"Synthetic test source observation",true)),
+            listOf(SourceBuildingObservation(building.buildingId,building.sourceMembers,true,"Synthetic test building observation",true)),
+            "00000000-0000-0000-0000-000000000077",null)
+        val ledger=NativeRegistrationLedger(root,kb,{currentSource},{_,_->null},{_,_->NativeSourceReconciliationContract.assignmentContentSha256(assignment)},
+            {_,_->NativeSourceReconciliationContract.draftFactsSha256(facts)})
+        val registered=ledger.register(facts,assignment,null)
+        val evidence=requireNotNull(ledger.current(id,registered.assignment.authoritySha256))
+        fun request(eligibility:NativeAssignmentEligibility=ledger,targetKb:TerritoryKnowledgeBase=kb)=LiveGeometryVerificationRequestFactory.create(
+            targetKb,policy,id,registered.assignment.authoritySha256,evidence.topology,evidence.buildingMembers,evidence.truth,
+            VerificationJurisdiction("Oakland County","Michigan","United States"),nativeEligibility=eligibility)
+        override fun close(){root.deleteRecursively()}
+    }
+    @Test fun actualReservedLegacyReferenceCanReachLiveVerificationOnlyThroughCurrentNativeAuthority() {
+        NativeFixture(baseline,"A257").use {f->
+            assertTrue(f.kb.referenceRoles.getValue(f.slot.referenceFile).role=="legacy_assignment_reference_needs_new_card")
+            assertTrue(runCatching {f.request(NativeAssignmentEligibility.NONE)}.isFailure)
+            val request=f.request()
+            assertTrue(request.assignmentSourceRole=="current_native_assignment_registration")
+            assertTrue(request.candidateSourceSha256!=request.lockedReferenceSha256 && request.needsNewCard)
+            assertTrue(LiveGeometryVerificationRequestFactory.fingerprintMatches(request))
+            assertTrue(request.siteAddressCrosscheckRequired && request.buildingOutlineCrosscheckRequired)
+        }
+    }
+    @Test fun commissionedA265AlsoUsesNativeAuthorityRatherThanPromotingItsOriginalPdf() {
+        NativeFixture(projected(),"A265").use {f->
+            val request=f.request()
+            assertTrue(request.assignmentSourceRole=="current_native_assignment_registration")
+            assertTrue(request.lockedReferenceSha256==original.referenceSha256)
+            assertTrue(request.knowledgeBaseRevision==projected().revision)
+            assertTrue(request.candidateBuildingMemberIds==listOf("99999"))
+        }
+    }
+    @Test fun legacySourceBytesWithoutALocalRegistrationRemainBlocked() {
+        val slot=baseline.assignments.getValue("A257")
+        NativeFixture(baseline,"A257").use {f->
+            val truth=f.evidence.truth.copy(assignmentAuthoritySourceSha256=slot.referenceSha256)
+            assertTrue(runCatching {LiveGeometryVerificationRequestFactory.create(baseline,policy,"A257",slot.referenceSha256,f.evidence.topology,
+                f.evidence.buildingMembers,truth,VerificationJurisdiction("Oakland County","Michigan","United States"))}.isFailure)
+        }
+    }
+    @Test fun sourceReplacementAndRevocationInvalidateNativeVerificationRequests() {
+        NativeFixture(baseline,"A257").use {f->
+            f.currentSource="c".repeat(64)
+            assertTrue(runCatching {f.request()}.isFailure)
+            f.currentSource=f.facts.importedSourceSha256
+            f.ledger.revoke(f.id,"REGULAR",f.registered.head.eventSha256,"Synthetic reviewer","2026-09-28T21:01:00Z")
+            assertTrue(runCatching {f.request()}.isFailure)
+        }
+    }
+    @Test fun nativeEvidenceCannotAuthorizeStyleOnlyOrAnotherCommissioningRevision() {
+        NativeFixture(projected(),"A265").use {f->
+            val role=f.kb.referenceRoles.getValue(f.slot.referenceFile).copy(role="style_only",fieldReleaseAllowed=false)
+            val style=f.kb.copy(referenceRoles=f.kb.referenceRoles+(f.slot.referenceFile to role))
+            assertTrue(runCatching {f.request(targetKb=style)}.isFailure)
+            val another=NativeCommissioningProjection.project(baseline,"A265",original.referenceSha256,"8".repeat(64))
+            assertTrue(runCatching {f.request(targetKb=another)}.isFailure)
+        }
+    }
+    @Test fun aNativeRequestCannotClaimAnApprovedPassthroughOrLegacyHash() {
+        NativeFixture(baseline,"A257").use {f->
+            val request=f.request()
+            assertTrue(runCatching {request.copy(needsNewCard=false)}.isFailure)
+            assertTrue(runCatching {request.copy(candidateSourceSha256=request.lockedReferenceSha256)}.isFailure)
+            assertTrue(runCatching {request.copy(assignmentSourceRole="legacy_assignment_reference_needs_new_card")}.isFailure)
+            assertTrue(!LiveGeometryVerificationRequestFactory.fingerprintMatches(request.copy(assignmentSourceRole="exact_assignment_reference")))
+        }
+    }
