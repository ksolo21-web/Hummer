+package com.koenterprises.territorycardstudio.core
+
+import java.io.File
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.Assertions.*
+
+class OutlinedCommissioningContractTest {
+    private val root=generateSequence(File(System.getProperty("user.dir")).absoluteFile){it.parentFile}
+        .first {File(it,"app/src/main/assets/territory").isDirectory}
+    private val assets=File(root,"app/src/main/assets/territory")
+    private val baseline=File(assets,"Territory-Knowledge-Base.json").reader().use(TerritoryKnowledgeBaseLoader::load)
+    private val policy=File(assets,"Online-Source-Policy.json").reader().use(OnlineSourcePolicyLoader::load)
+    private val original=baseline.assignments.getValue("A265")
+    private val hash="7".repeat(64)
+    private fun projected()=NativeCommissioningProjection.project(baseline,"A265",original.referenceSha256,hash)
+
+    @Test fun a265CanHaveASeparateCandidateWithoutChangingTheInstalledAssignment() {
+        val before=original.copy();val result=projected();val candidate=result.assignments.getValue("A265")
+        assertTrue(candidate.needsNewCard && candidate.newCardApproved==false && !candidate.fieldReleaseAllowedForExactArtifact)
+        assertTrue(candidate.identity==original.identity && candidate.canonicalFilename==original.canonicalFilename)
+        assertTrue(baseline.assignments.getValue("A265")==before && !original.needsNewCard)
+        assertTrue(result.revision=="commission-$hash" && result.revision!=baseline.revision)
+        assertTrue(result.needsNewCardQueue.size==baseline.needsNewCardQueue.size+1)
+    }
+    @Test fun allNeighborAssignmentsAndGeographyPoliciesRemainIdentical() {
+        val result=projected()
+        assertTrue(result.assignments.filterKeys {it!="A265"}==baseline.assignments.filterKeys {it!="A265"})
+        assertTrue(result.policy==baseline.policy && result.crossTerritoryOverlapAudit==baseline.crossTerritoryOverlapAudit)
+        assertTrue(result.masterCoverage==baseline.masterCoverage && result.coverageCandidates==baseline.coverageCandidates)
+        assertTrue(result.classSupersessions==baseline.classSupersessions && result.permanentPatches==baseline.permanentPatches)
+        assertTrue(result.assignments.getValue("A265").roads==original.roads && result.assignments.getValue("A265").buildings==original.buildings)
+    }
+    @Test fun originalExactExportRemainsAllowedButCannotBeReusedAsANewCandidate() {
+        val old=PdfArtifactBoundary.authorizeExactApprovedPassthrough(baseline,"A265",original.canonicalFilename,original.referenceSha256)
+        val candidate=PdfArtifactBoundary.authorizeExactApprovedPassthrough(projected(),"A265",original.canonicalFilename,original.referenceSha256)
+        assertTrue(old.fieldReleaseState==PdfFieldReleaseState.ALLOWED)
+        assertTrue(candidate.fieldReleaseState==PdfFieldReleaseState.BLOCKED)
+        assertTrue(projected().referenceRoles.getValue(original.referenceFile).role=="legacy_assignment_reference_needs_new_card")
+        assertTrue(baseline.referenceRoles.getValue(original.referenceFile).fieldReleaseAllowed)
+    }
+    @Test fun unknownRetiredAndAlreadyReservedTerritoriesCannotBeCommissionedThisWay() {
+        for(id in listOf("A296","R296","NOT-A-TERRITORY","A257")) {
+            assertTrue(runCatching {NativeCommissioningProjection.project(baseline,id,original.referenceSha256,hash)}.isFailure)
+        }
+        assertTrue(runCatching {NativeCommissioningProjection.project(projected(),"A265",original.referenceSha256,hash)}.isFailure)
+    }
+    @Test fun changedReferenceOrScopeDigestCannotReuseTheProjection() {
+        assertTrue(runCatching {NativeCommissioningProjection.project(baseline,"A265","0".repeat(64),hash)}.isFailure)
+        for(value in listOf("", "abc", "Z".repeat(64), "0".repeat(65)))
+            assertTrue(runCatching {NativeCommissioningProjection.project(baseline,"A265",original.referenceSha256,value)}.isFailure)
+        val other=NativeCommissioningProjection.project(baseline,"A265",original.referenceSha256,"8".repeat(64))
+        assertTrue(other.revision!=projected().revision)
+    }
+    @Test fun aStyleReferenceCannotBePromotedIntoACommissionedAssignment() {
+        val role=baseline.referenceRoles.getValue(original.referenceFile).copy(role="style_only",fieldReleaseAllowed=false)
+        val altered=baseline.copy(referenceRoles=baseline.referenceRoles+(original.referenceFile to role))
+        assertTrue(runCatching {NativeCommissioningProjection.project(altered,"A265",original.referenceSha256,hash)}.isFailure)
+    }
+
+    /** Synthetic core facts, not image/card acceptance. Real installed identities expose the
+     * legacy-reference role that the old synthetic-reserved-slot tests accidentally avoided. */
