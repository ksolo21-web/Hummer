+++ b/core/src/main/kotlin/com/koenterprises/territorycardstudio/core/NativeCommissioningProjection.kt
@@ -0,0 +1,44 @@
+package com.koenterprises.territorycardstudio.core
+
+/** A separate replacement-candidate workspace, NOT a change to the installed catalog.
+ * Application code must obtain its scope digest from the private, explicit commissioning
+ * ledger. This projection is data preparation only and grants no source or PDF approval. */
+object NativeCommissioningProjection {
+    fun project(baseline: TerritoryKnowledgeBase, territory: String,
+        lockedReferenceSha256: String, scopeSha256: String): TerritoryKnowledgeBase {
+        require(scopeSha256.matches(Regex("[0-9a-f]{64}"))) { "Invalid commissioning scope digest" }
+        val original = requireNotNull(baseline.assignments[territory]) { "Unknown or retired territory" }
+        require(!original.needsNewCard) { "This territory already has a new-card workspace" }
+        require(original.referenceSha256 == lockedReferenceSha256) { "Commissioning reference changed" }
+        val reference = requireNotNull(baseline.referenceRoles[original.referenceFile]) { "Original reference role is missing" }
+        require(reference.role == "exact_assignment_reference" && !reference.crossTerritoryGeographyAllowed) { "Only this territory's installed exact reference may be preserved" }
+        require(reference.displayId == territory && reference.sha256 == original.referenceSha256) { "Reference identity mismatch" }
+        require(baseline.assignments.values.count { it.referenceFile == original.referenceFile } == 1) { "Reference is shared by multiple assignments" }
+        val replacement = original.copy(
+            status = "needs_new_card",
+            needsNewCard = true,
+            newCardApproved = false,
+            fieldReleaseAllowedForExactArtifact = false,
+            sourceClass = "legacy_reference_not_current_approved_card",
+            legacyVisibleId = original.displayId,
+            legacyReferenceFile = original.referenceFile,
+            approvalNote = "Separate commissioned replacement candidate. The installed original remains unchanged; no candidate is pre-approved."
+        )
+        val revision = "commission-" + scopeSha256
+        val result = baseline.copy(
+            revision = revision,
+            assignments = baseline.assignments + (territory to replacement),
+            referenceRoles = baseline.referenceRoles + (original.referenceFile to reference.copy(
+                role = "legacy_assignment_reference_needs_new_card", fieldReleaseAllowed = false)),
+            needsNewCardQueue = baseline.needsNewCardQueue + (territory to NeedsNewCardEntry(
+                territory, "needs_new_card", original.canonicalFilename, original.referenceFile, false)),
+            populationSummary = baseline.populationSummary.copy(needsNewCardCount = baseline.populationSummary.needsNewCardCount + 1)
+        )
+        // No numbering, coverage, source geometry, overlap, housing, renderer or approval-policy changes.
+        require(result.assignments.filterKeys { it != territory } == baseline.assignments.filterKeys { it != territory })
+        require(result.policy == baseline.policy && result.classSupersessions == baseline.classSupersessions)
+        require(result.crossTerritoryOverlapAudit == baseline.crossTerritoryOverlapAudit && result.permanentPatches == baseline.permanentPatches)
+        require(result.assignments.getValue(territory).roads == original.roads && result.assignments.getValue(territory).buildings == original.buildings)
+        return result
+    }
+}
