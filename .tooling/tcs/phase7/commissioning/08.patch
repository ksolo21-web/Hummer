diff --git a/app/src/androidTest/java/com/koenterprises/territorycardstudio/Phase7ScreenEvidence.kt b/app/src/androidTest/java/com/koenterprises/territorycardstudio/Phase7ScreenEvidence.kt
new file mode 100644
--- /dev/null
+++ b/app/src/androidTest/java/com/koenterprises/territorycardstudio/Phase7ScreenEvidence.kt
@@ -0,0 +1,99 @@
+package com.koenterprises.territorycardstudio
+
+import android.graphics.Bitmap
+import android.os.ParcelFileDescriptor
+import androidx.test.platform.app.InstrumentationRegistry
+import com.koenterprises.territorycardstudio.core.BundleIntegrity
+import org.json.JSONObject
+import java.io.File
+
+/** A passing Compose assertion alone cannot establish visible-screen evidence: a system
+ * dialog can cover the application while semantics assertions keep running. Never crop
+ * around or dismiss a blocking window. Retain the full screenshot and independent
+ * foreground witnesses. Missing emulator accessibility roots are retried; foreign focus
+ * is rejected immediately rather than waited away. */
+internal object Phase7ScreenEvidence {
+    private val component=Regex("""([A-Za-z0-9_.]+)/[A-Za-z0-9_.$]+""")
+
+    private data class WindowWitness(
+        val accessibilityPackage:String?,
+        val focusedWindowPackage:String?,
+        val resumedActivityPackage:String?
+    ) {
+        fun foreign(expected:String)=listOfNotNull(accessibilityPackage,focusedWindowPackage,resumedActivityPackage).any {it!=expected}
+        fun accepted(expected:String):Boolean {
+            if(foreign(expected)) return false
+            return focusedWindowPackage==expected ||
+                (accessibilityPackage==expected && resumedActivityPackage==expected)
+        }
+        fun resolved(expected:String):String?=when {
+            accepted(expected)->expected
+            focusedWindowPackage!=null->focusedWindowPackage
+            accessibilityPackage!=null->accessibilityPackage
+            else->resumedActivityPackage
+        }
+    }
+
+    private fun shellPackage(command:String,markers:List<String>):String? {
+        val automation=InstrumentationRegistry.getInstrumentation().uiAutomation
+        return runCatching {
+            ParcelFileDescriptor.AutoCloseInputStream(automation.executeShellCommand(command))
+                .bufferedReader().use {reader->
+                    reader.lineSequence().firstNotNullOfOrNull {line->
+                        if(markers.none {line.contains(it)}) null else component.find(line)?.groupValues?.getOrNull(1)
+                    }
+                }
+        }.getOrNull()
+    }
+
+    private fun witness():WindowWitness {
+        val automation=InstrumentationRegistry.getInstrumentation().uiAutomation
+        val accessibility=automation.rootInActiveWindow?.packageName?.toString()?.takeIf {it.isNotBlank()}
+        val focused=shellPackage("dumpsys window",listOf("mCurrentFocus=","mFocusedApp="))
+        val resumed=shellPackage("dumpsys activity activities",listOf("mResumedActivity:","topResumedActivity=","mFocusedActivity:"))
+        return WindowWitness(accessibility,focused,resumed)
+    }
+
+    private fun stableWitness(expected:String):WindowWitness {
+        repeat(40) {
+            val current=witness()
+            if(current.foreign(expected) || current.accepted(expected)) return current
+            Thread.sleep(100)
+        }
+        return witness()
+    }
+
+    fun capture(file:File) {
+        require(file.name.startsWith("phase7-") && file.extension=="png")
+        val instrumentation=InstrumentationRegistry.getInstrumentation()
+        val automation=instrumentation.uiAutomation
+        val expected=instrumentation.targetContext.packageName
+        // Prime Accessibility/WindowManager without retaining or substituting this bitmap.
+        automation.takeScreenshot()?.recycle()
+        val before=stableWitness(expected)
+        check(before.accepted(expected)) {
+            "Screenshot precondition is not valid app evidence: before=$before expected=$expected"
+        }
+        val image=requireNotNull(automation.takeScreenshot()) {"No visible-screen bitmap was returned"}
+        try {file.outputStream().use {check(image.compress(Bitmap.CompressFormat.PNG,100,it))}}
+        finally {image.recycle()}
+        val after=stableWitness(expected)
+        val accepted=before.accepted(expected) && after.accepted(expected)
+        val receipt=JSONObject().put("schema","phase7-screen-evidence-v3")
+            .put("expectedPackage",expected)
+            .put("activePackageBefore",before.resolved(expected) ?: JSONObject.NULL)
+            .put("activePackageAfter",after.resolved(expected) ?: JSONObject.NULL)
+            .put("accessibilityPackageBefore",before.accessibilityPackage ?: JSONObject.NULL)
+            .put("accessibilityPackageAfter",after.accessibilityPackage ?: JSONObject.NULL)
+            .put("focusedWindowPackageBefore",before.focusedWindowPackage ?: JSONObject.NULL)
+            .put("focusedWindowPackageAfter",after.focusedWindowPackage ?: JSONObject.NULL)
+            .put("resumedActivityPackageBefore",before.resumedActivityPackage ?: JSONObject.NULL)
+            .put("resumedActivityPackageAfter",after.resumedActivityPackage ?: JSONObject.NULL)
+            .put("screenshotSha256",file.inputStream().use(BundleIntegrity::sha256))
+            .put("accepted",accepted).put("testOnly",true).put("cardApproved",false)
+        File(file.parentFile,file.nameWithoutExtension+"-screen.json").writeText(receipt.toString(2))
+        check(accepted) {
+            "Screenshot is not valid app evidence: before=$before after=$after expected=$expected; full screenshot and receipt were retained"
+        }
+    }
+}
