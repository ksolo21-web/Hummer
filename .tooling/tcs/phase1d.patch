+object CanonicalFrontBackPdfExactValidator {
+    fun validate(
+        pdf: ByteArray,
+        spec: CanonicalAddressBackSpec,
+        expectedFrontSha256: String,
+        expectedBackSpecSha256: String
+    ): CanonicalFrontBackPdfValidation {
+        val errors = mutableListOf<String>()
+        val raw = pdf.toString(Charsets.ISO_8859_1)
+        if (!raw.startsWith("%PDF-")) errors += "Not a PDF"
+        if (!raw.contains("% TCS_CANONICAL_FRONT_BACK_V1")) errors += "Canonical front/back marker missing"
+        if (!raw.contains("% TCS_PAGE_ROLE BACK_ADDRESS_LIST")) errors += "Back page role marker missing"
+        if (!raw.contains("/Count 2 /Kids [ 4 0 R 21 0 R ] /Type /Pages")) errors += "Canonical page count/order is not FRONT_MAP then BACK_ADDRESS_LIST"
+        if (!raw.contains("21 0 obj") || !raw.contains("/Contents 22 0 R") || !raw.contains("/Parent 19 0 R")) errors += "Canonical back-page object binding missing"
+        if (!raw.contains("page_roles=FRONT_MAP,BACK_ADDRESS_LIST")) errors += "Canonical page-role metadata missing"
+        if (!raw.contains("front_sha256=$expectedFrontSha256")) errors += "Front hash binding missing"
+        if (!raw.contains("back_spec_sha256=$expectedBackSpecSha256")) errors += "Back spec hash binding missing"
+        if (!raw.contains("address_source_sha256=${spec.sourceInventorySha256}")) errors += "Address-source hash binding missing"
+        if (!raw.contains("card-display-id:${spec.identity.displayId}")) errors += "Combined metadata display ID mismatch"
+        if (!raw.contains("canonical-filename:${spec.identity.canonicalFilename}")) errors += "Combined metadata canonical filename mismatch"
+        if (Regex("% TCS_PAGE_ROLE FRONT_MAP").findAll(raw).count() > 1) errors += "Duplicate FRONT_MAP page-role marker"
+        if (Regex("% TCS_PAGE_ROLE BACK_ADDRESS_LIST").findAll(raw).count() != 1) errors += "BACK_ADDRESS_LIST page-role cardinality mismatch"
+        return CanonicalFrontBackPdfValidation(errors.isEmpty(), errors, if (errors.any { it.contains("page count/order") }) 0 else 2, listOf(TerritoryPdfPageRole.FRONT_MAP, TerritoryPdfPageRole.BACK_ADDRESS_LIST))
+    }
+}
