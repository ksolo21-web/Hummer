+data class CanonicalAddressBackSpec(
+    val identity: TerritoryIdentity,
+    val locality: String,
+    val updated: String,
+    val sourceInventorySha256: String,
+    val sourceInventoryVerified: Boolean,
+    val entries: List<CanonicalAddressEntry>,
+    val nonFieldFixture: Boolean = false
+) {
+    fun canonicalSha256(): String = sha256(buildString {
+        append("display_id=").append(identity.displayId).append('\n')
+        append("canonical_filename=").append(identity.canonicalFilename).append('\n')
+        append("locality=").append(locality).append('\n')
+        append("source_inventory_sha256=").append(sourceInventorySha256).append('\n')
+        append("source_inventory_verified=").append(sourceInventoryVerified).append('\n')
+        append("non_field_fixture=").append(nonFieldFixture).append('\n')
+        entries.forEachIndexed { index, entry ->
+            append("entry[").append(index).append("]=")
+                .append(entry.sourceId).append('|').append(entry.addressLine).append('\n')
+        }
+    }.toByteArray(Charsets.UTF_8))
+}
